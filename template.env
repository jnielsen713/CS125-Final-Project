# Usually root
DB_USER=root
# Usually localhost
DB_HOST=localhost
# Check docker to see which port, 3306 is default for sql
DB_PORT=3306
# --[EDIT HERE]-----------------------------------------------------------------
# User password. this is sensitive but .gitignroe ensures privacy
DB_PASSWORD=YOUR_PASSWORD
# ------------------------------------------------------------------------------
# Name of database (in our case, youth_group_database)
DB_NAME=youth_group_database
